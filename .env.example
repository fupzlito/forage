# Forage Environment Variables Example
# Copy to .env and adjust for your instance or pass to docker-compose / docker run.
# Environment variables override config.yaml and default settings.

# --- Authentication & Paths ---
# Comma-separated API keys, required when auth.enabled is true
# Example: FORAGE_API_KEYS=key1,key2
FORAGE_API_KEYS=

# Path to config YAML file (defaults to /etc/forage/config.yaml)
# FORAGE_CONFIG=/etc/forage/config.yaml

# Path to external prompts YAML file (optional)
# FORAGE_PROMPTS_CONFIG=/etc/forage/prompts.yaml

# Master authentication toggle (true/false)
# FORAGE_AUTH_ENABLED=false

# --- Search (SearXNG) ---
# Base URL for SearXNG instance
# FORAGE_SEARXNG_URL=http://searxng:8080

# Comma-separated search engine filter
# FORAGE_SEARCH_ENGINES=google,bing,brave,duckduckgo,qwant

# Default search language
# FORAGE_SEARCH_DEFAULT_LANG=en-US

# --- Browser & Extraction ---
# Browser engine: "playwright", "patchright", "scrapling" (stealth anti-bot), or "obscura"
# FORAGE_BROWSER_ENGINE=playwright

# Obscura CDP endpoint URL (when engine=obscura)
# FORAGE_BROWSER_CDP_URL=http://obscura:9223

# Run browser in headless mode (true/false)
# FORAGE_BROWSER_HEADLESS=true

# Extraction engine: "trafilatura" (default) or "readability"
# FORAGE_EXTRACT_ENGINE=trafilatura

# Require LLMs to specify max_chars character budgets (true/false)
# FORAGE_REQUIRE_MAX_CHARS=false

# --- Server & Caching ---
# Server port (default: 3672)
# FORAGE_PORT=3672

# Server host (default: 0.0.0.0)
# FORAGE_HOST=0.0.0.0

# Log level: debug | info | warning | error
# FORAGE_LOG_LEVEL=info

# Master cache toggle (true/false)
# FORAGE_CACHE_ENABLED=true

# Container timezone (used for dynamic date/time injection in prompts)
TZ=America/Recife
